# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# ── Virtual environments ────────────────────────────────────
venv/
.venv/

# ── Data ────────────────────────────────────────────────────
# framework/data/ has exactly three top-level folders and none of their
# contents are committed — only the folder structure (.gitkeep):
#   benchmarks/<task>/  source benchmark files (fce.m2, *.csv, *.jsonl)
#   profiles/           profile JSON from `python -m framework.profile_dataset`
#   runs/               per-session run artifacts
framework/data/**
!framework/data/**/
!framework/data/**/.gitkeep
# Explicit (redundant with framework/data/** above): never track dataset or
# run-artifact json/csv under framework/data, whatever the layout.
framework/data/**/*.json
framework/data/**/*.csv

# ── Run artifacts ───────────────────────────────────────────
# Results files are build artifacts, rewritten on every run —
# committing them keeps the working tree permanently dirty.
results.json
results/

# ── Experiments ─────────────────────────────────────────────
# Personal scratch space: notebooks, local datasets, venvs. Kept on disk,
# never in the repo — it reached 59GB locally.
experiments/

# ── Secrets ─────────────────────────────────────────────────
# Keep example.env as the template; real keys go in .env (never committed).
.env

# ── Caches & tooling ────────────────────────────────────────
.pip-cache/
.devcontainer/

# ── IDE / OS noise ──────────────────────────────────────────
.idea/
.vscode/
.DS_Store

# ── Tooling scratch ─────────────────────────────────────────
# Only the agent scratch dirs are ignored — docs/ itself holds real
# project documentation (e.g. docs/taxonomy_induction.md).
docs/superpowers/
.superpowers